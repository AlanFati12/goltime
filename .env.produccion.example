# Copia este archivo a .env EN EL SERVIDOR y reemplaza TODOS los valores. NUNCA lo subas al repositorio.

# --- Dominio (sin https://) ---
DOMINIO=goltime.alanpc.tech

# --- Base de datos ---
DB_NOMBRE=goltime
DB_USUARIO=goltime
# Genera con: openssl rand -base64 24
DB_CLAVE=GENERA-UNA-CLAVE-ALEATORIA

# --- Seguridad ---
# Genera con: openssl rand -base64 48
JWT_SECRETO=GENERA-UN-SECRETO-ALEATORIO-DE-MAS-DE-32-CARACTERES

# --- Administrador inicial (se crea solo en el primer arranque) ---
ADMIN_CORREO=tu-correo@ejemplo.com
ADMIN_CLAVE=UNA-CLAVE-FUERTE-QUE-SOLO-TU-SEPAS

# --- Correo real (Brevo, Resend, SendGrid o similar) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_AUTENTICACION=true
SMTP_STARTTLS=true
# Debe ser una dirección de un dominio verificado en tu proveedor de correo.
CORREO_REMITENTE=no-responder@alanpc.tech
# Déjalo en false hasta comprobar que los correos llegan; luego cámbialo a true.
VERIFICACION_CORREO_OBLIGATORIA=false

# --- Datos de demostración (solo el servicio `demo`) ---
DEMO_CLAVE_CLIENTES=CAMBIA-ESTA-CLAVE
