    {
      "parameters": {
        "jsCode": "// La API firma cada aviso con HMAC-SHA256 del cuerpo exacto (cabecera X-Firma-Goltime). Sin firma válida no se envía nada.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst firma = String((item.json.headers || {})['x-firma-goltime'] || '');\nconst crudo = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst esperada = 'sha256=' + crypto.createHmac('sha256', $env.GOLTIME_SECRETO_AVISOS || '').update(crudo).digest('hex');\nconst valida = !!$env.GOLTIME_SECRETO_AVISOS && firma.length === esperada.length\n  && crypto.timingSafeEqual(Buffer.from(firma), Buffer.from(esperada));\nlet aviso = {};\ntry { aviso = JSON.parse(crudo.toString('utf8')); } catch (e) { aviso = {}; }\n// Teléfono (+57…) o chat @lid de quien no compartió su número.\nconst destino = String(aviso.numero || '');\nconst numero = destino.endsWith('@lid') ? destino : destino.replace(/\\D/g, '');\nreturn [{ json: { valida: valida && numero.length >= 8 && !!aviso.mensaje, numero, mensaje: aviso.mensaje, tipo: aviso.tipo, reservaId: aviso.reservaId } }];"
      },
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "¿Firma válida?",
              "leftValue": "={{ $json.valida }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "¿Firma válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
