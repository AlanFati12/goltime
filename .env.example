# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# --- Base de datos ---
DB_NOMBRE=goltime
DB_USUARIO=goltime
DB_CLAVE=cambia-esta-clave
DB_PUERTO_LOCAL=5433

# --- Seguridad ---
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-aleatorio-de-mas-de-32-caracteres
COOKIE_SEGURA=false

# --- Aplicación ---
PERFIL=dev
WEB_PUERTO=8081
CORS_ORIGENES=http://localhost:8081,http://localhost:5173

# --- Administrador inicial (se crea en el primer arranque; se usa desde la Fase 1) ---
ADMIN_CORREO=admin@goltime.local
ADMIN_CLAVE=cambia-esta-clave-de-admin-1

# --- Correo ---
# Desarrollo: Mailpit (ver correos en http://localhost:8025). Para correo real, cambia estos valores.
SMTP_HOST=mailpit
SMTP_PUERTO=1025
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_AUTENTICACION=false
SMTP_STARTTLS=false
CORREO_REMITENTE=no-responder@goltime.local

# --- Enlaces de los correos y verificación ---
# URL desde la que los usuarios abren la web (los correos enlazan aquí).
URL_PUBLICA=http://localhost:8081
# Si es true, el cliente debe verificar su correo antes de ingresar.
VERIFICACION_CORREO_OBLIGATORIA=false

# --- Archivos subidos (fotos) ---
# En Docker apunta al volumen de uploads; en desarrollo local por defecto es ./uploads.
DIRECTORIO_ARCHIVOS=/app/uploads

# --- Datos de demostración (solo el servicio `demo`: docker compose --profile demo run --rm demo) ---
DEMO_CLAVE_CLIENTES=Demo2026*

# --- Cliente de prueba (lo crea scripts/reiniciar-base.sh; si no existe, el script lo agrega a tu .env) ---
CLIENTE_PRUEBA_CORREO=cliente@goltime.local
CLIENTE_PRUEBA_CLAVE=cambia-esta-clave-1

# --- Bot de WhatsApp (ADR 0018; solo con docker-compose.whatsapp.yml) ---
# Genera cada secreto con: openssl rand -hex 32
# Clave con la que n8n llama a /api/v1/integracion/whatsapp/** (cabecera X-Clave-Integracion).
WHATSAPP_CLAVE_INTEGRACION=cambia-esta-clave-de-integracion
# Firma (HMAC) de los avisos que la API envía a n8n.
WHATSAPP_SECRETO_AVISOS=cambia-este-secreto-de-avisos
# Webhook de n8n que recibe los avisos de la API.
WHATSAPP_URL_AVISOS=http://n8n:5678/webhook/goltime-avisos
# n8n: no cambies la clave de cifrado después de crear credenciales.
N8N_CLAVE_CIFRADO=cambia-esta-clave-de-cifrado-de-n8n
N8N_PUERTO=5678
N8N_URL_PUBLICA=http://localhost:5678/
# Evolution API (WhatsApp)
EVOLUTION_CLAVE_API=cambia-esta-clave-de-evolution
EVOLUTION_DB_CLAVE=cambia-esta-clave-de-la-base-de-evolution
EVOLUTION_PUERTO=8082
EVOLUTION_URL_PUBLICA=http://localhost:8082
EVOLUTION_INSTANCIA=goltime
