# Caddy obtiene y renueva solo el certificado de Let's Encrypt para {$DOMINIO}.
# Requisito: el registro DNS A del dominio ya apunta a la IP del servidor y los puertos 80 y 443 están abiertos.
{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy web:80
}
