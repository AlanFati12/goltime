# Caddy obtiene y renueva solo el certificado de Let's Encrypt para {$DOMINIO}.
# Requisito: el registro DNS A del dominio ya apunta a la IP del servidor y los puertos 80 y 443 están abiertos.
{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# La API del bot de WhatsApp solo la usa n8n por la red interna de Docker; desde internet no existe.
	@integracion path /api/v1/integracion/*
	respond @integracion 404

	# Sin Accept-Encoding hacia nginx: así comprime Caddy (zstd o gzip, el mejor que entienda el navegador) y no nginx.
	reverse_proxy web:80 {
		header_up -Accept-Encoding
	}
}
